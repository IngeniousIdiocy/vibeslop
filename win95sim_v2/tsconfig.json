{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": "./src",
    "paths": {
      "@core/*": ["core/*"],
      "@services/*": ["services/*"],
      "@ui/*": ["ui/*"],
      "@apps/*": ["apps/*"],
      "@shell/*": ["shell/*"],
      "@features/*": ["features/*"]
    },
    "types": ["./src/types/css"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "tests/helpers/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
